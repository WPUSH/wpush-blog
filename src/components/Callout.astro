---
/** 与主站文档同名的提示块，MDX 内 `import Callout from "@/components/Callout.astro"` 使用 */
interface Props {
  type?: "info" | "warn" | "tip";
  title?: string;
}
const { type = "info", title } = Astro.props;
const styles = {
  info: "border-border bg-muted",
  warn: "border-warning/40 bg-warning/5",
  tip: "border-success/40 bg-success/5",
}[type];
const label = title ?? { info: "说明", warn: "注意", tip: "建议" }[type];
---

<aside class:list={["not-prose my-6 rounded-lg border px-4 py-3 text-sm leading-relaxed", styles]}>
  <div class="mb-1 font-medium">{label}</div>
  <div class="[&_a]:underline [&_code]:rounded [&_code]:bg-secondary [&_code]:px-1 [&_p]:m-0"><slot /></div>
</aside>
