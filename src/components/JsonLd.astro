---
interface Props {
  data: Record<string, unknown> | Record<string, unknown>[];
}
const { data } = Astro.props;
const items = Array.isArray(data) ? data : [data];
// JSON.stringify 后把 < 转义，避免内容里出现 </script> 提前闭合
const json = items.map((d) => JSON.stringify(d).replace(/</g, "\\u003c"));
---

{json.map((j) => <script is:inline type="application/ld+json" set:html={j} />)}
