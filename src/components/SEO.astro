---
/**
 * 页面 <head> 的 SEO 部分。canonical 永远指向 wpush.cn/blog/...（Astro.url.pathname 已含 base），
 * 回源域名 blog.wpush.cn 上的重复页面靠它归并权重。
 */
import { SITE } from "@/lib/site";
import { absolute, absoluteFromPathname, href } from "@/lib/url";

interface Props {
  title: string;
  description: string;
  type?: "website" | "article";
  image?: string;
  publishDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  /** 文章的纯 Markdown 版本路径（不含 base） */
  markdownPath?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  type = "website",
  image,
  publishDate,
  updatedDate,
  tags = [],
  markdownPath,
  noindex = false,
} = Astro.props;

const canonical = absoluteFromPathname(Astro.url.pathname);
const fullTitle = title === SITE.name ? title : `${title} · ${SITE.name}`;
const ogImage = image ? (image.startsWith("http") ? image : absolute(image)) : absolute("/logo.png");
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content="zh_CN" />
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
{type === "article" && publishDate && (
  <meta property="article:published_time" content={publishDate.toISOString()} />
)}
{type === "article" && updatedDate && (
  <meta property="article:modified_time" content={updatedDate.toISOString()} />
)}
{type === "article" && tags.map((t) => <meta property="article:tag" content={t} />)}

<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<link rel="alternate" type="application/rss+xml" title={SITE.name} href={href("/rss.xml")} />
{markdownPath && <link rel="alternate" type="text/markdown" title="Markdown 版本" href={href(markdownPath)} />}
