---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { href } from "@/lib/url";
---

<BaseLayout title="页面不存在" description="你访问的页面不存在或已被移动。回到 WPush 博客首页继续浏览教程与解决方案。" noindex>
  <div class="mx-auto max-w-6xl px-4 pt-24 text-center sm:px-6">
    <p class="text-sm text-muted-foreground">404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">页面不存在</h1>
    <p class="mt-3 text-muted-foreground">可能是链接写错了，或者这篇内容已经移动。</p>
    <a href={href("/")} class="focus-ring mt-8 inline-block rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground">
      回到博客首页
    </a>
  </div>
</BaseLayout>
